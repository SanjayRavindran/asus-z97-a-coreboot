@@ -143,6 +143,12 @@ Name (MCRS, ResourceTemplate()
 			0x00000000, 0x00000000, 0x00000000, 0x00000000,
 			0x00000000,,, PM02)
 #endif
+	// PCI Memory Region above 4G (TOUUD -> 1 << cpu_phys_address_size)
+	QWordMemory (ResourceProducer, PosDecode, MinFixed, MaxFixed,
+			NonCacheable, ReadWrite,
+			0x00000000, 0x00000000, 0x00000000, 0x00000000,
+			0x00000000,,, PM64)
+
 	// TPM Area (0xfed40000-0xfed44fff)
 	DWordMemory (ResourceProducer, PosDecode, MinFixed, MaxFixed,
 			Cacheable, ReadWrite,
@@ -150,6 +156,9 @@ Name (MCRS, ResourceTemplate()
 			0x00005000,,, TPMR)
 })
 
+External (\A4GS, IntObj)
+External (\A4GB, IntObj)
+
 Method (_CRS, 0, Serialized)
 {
 	// Set highest PCI bus and length
@@ -212,6 +221,15 @@ Method (_CRS, 0, Serialized)
 		PM2L = PM2M - PM2B + 1
 	}
 #endif
+	If (\A4GS != 0) {
+		CreateQwordField (MCRS, ^PM64._MIN, M64N)
+		CreateQwordField (MCRS, ^PM64._MAX, M64X)
+		CreateQwordField (MCRS, ^PM64._LEN, M64L)
+		M64L = \A4GS
+		M64N = \A4GB
+		M64X = M64N + M64L - 1
+	}
+
 	Return (MCRS)
 }
 
