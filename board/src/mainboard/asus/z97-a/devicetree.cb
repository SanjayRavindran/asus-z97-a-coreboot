## SPDX-License-Identifier: GPL-2.0-or-later

chip northbridge/intel/haswell
	register "gpu_ddi_e_connected" = "1"
	register "gpu_dp_b_hotplug" = "4"
	register "gpu_dp_c_hotplug" = "4"
	register "gpu_dp_d_hotplug" = "4"
	register "gfx" = "{
		.use_spread_spectrum_clock = 0,
		.ndid = 5,
		.did = { 0x0100, 0x0300, 0x0301, 0x0302, 0x0303 },
	}"
	register "spd_addresses" = "{0x50, 0x51, 0x52, 0x53}"

	chip cpu/intel/haswell
		device cpu_cluster 0 on
			ops haswell_cpu_bus_ops
		end
	end

	device domain 0 on
		ops haswell_pci_domain_ops
		subsystemid 0x1043 0x8534 inherit

		device pci 00.0 on end		# Desktop Host bridge
		device pci 01.0 on		# PEG #1 (PCIEX16_1)
			smbios_slot_desc "SlotTypePciExpressGen3" "SlotLengthLong"
					 "PCIEX16_1" "SlotDataBusWidth16X"
		end
		device pci 01.1 on		# PEG #2 (PCIEX16_2)
			smbios_slot_desc "SlotTypePciExpressGen3X16" "SlotLengthLong"
					 "PCIEX16_2" "SlotDataBusWidth8X"
		end
		device pci 01.2 on		# PEG #3 (Bifurcated x8/x4/x4 when CFG[6:5]=00)
		end
		device pci 02.0 on end		# iGPU (HD 4600)
		device pci 03.0 on end		# Mini-HD audio (Haswell HDMI)

		chip southbridge/intel/lynxpoint # Intel Z97 Lynx Point PCH
			register "gen1_dec" = "0x003c0291"
			register "gen2_dec" = "0x007c0a01"
			register "gen4_dec" = "0x000cff29"
			register "gpe0_en_1" = "0x40042246"
			register "sata_port_map" = "0x3f"
			register "xhci_default" = "1"

			device pci 14.0 on  end		# xHCI Controller
			device pci 16.0 on  end		# MEI #1
			device pci 16.1 off end		# MEI #2
			device pci 19.0 on		# Intel I218-V GbE
				subsystemid 0x1043 0x85c4
			end
			device pci 1a.0 off end		# USB2 EHCI #2 (disabled in stock FD=0x03b62001)
			device pci 1b.0 on		# High Definition Audio (ALC892)
				subsystemid 0x1043 0x860b
			end
			device pci 1c.0 on  end		# RP #1 (SATA Express / M.2 Flex-I/O x2; auto-disabled when SATA5/6 own lanes)
			device pci 1c.1 off end		# RP #2 (absorbed by RP #1 x2)
			device pci 1c.2 off end		# RP #3 (I218-V GbE)
			device pci 1c.3 on		# RP #4 (ASMedia ASM1083 PCIe-to-PCI bridge)
				device pci 00.0 on end
			end
			device pci 1c.4 on		# RP #5 (PCIEX16_3 max x2)
				smbios_slot_desc "SlotTypePciExpressGen2X16" "SlotLengthLong"
						 "PCIEX16_3" "SlotDataBusWidth2X"
			end
			device pci 1c.5 off end		# RP #6 (absorbed by RP #5 x2)
			device pci 1c.6 on		# RP #7 (PCIEX1_2 / I226-V -> bus 5 enp5s0)
				smbios_slot_desc "SlotTypePciExpressGen2" "SlotLengthShort"
						 "PCIEX1_2" "SlotDataBusWidth1X"
			end
			device pci 1c.7 on		# RP #8 (PCIEX1_1)
				smbios_slot_desc "SlotTypePciExpressGen2" "SlotLengthShort"
						 "PCIEX1_1" "SlotDataBusWidth1X"
			end
			device pci 1d.0 on  end		# USB2 EHCI #1
			device pci 1f.0 on		# LPC bridge
				chip superio/common
					device pnp 2e.0 on
						chip superio/nuvoton/nct6791d
							device pnp 2e.1   off end	# Parallel
							device pnp 2e.2   on		# UART A (COM1)
								io  0x60 = 0x03f8
								irq 0x70 = 4
							end
							device pnp 2e.3   off end	# IR
							device pnp 2e.5   on		# PS/2 Keyboard/Mouse
								io  0x60 = 0x0060
								io  0x62 = 0x0064
								irq 0x70 = 1
								irq 0x72 = 12
								irq 0xf0 = 0x82
							end
							device pnp 2e.6   off end	# CIR
							device pnp 2e.7   off end	# GPIO6
							device pnp 2e.107 off end	# GPIO7
							device pnp 2e.207 off end	# GPIO8
							device pnp 2e.8   off end	# WDT
							device pnp 2e.108 on		# GPIO0
								irq 0xe1 = 0x80
							end
							device pnp 2e.308 off end	# GPIO base
							device pnp 2e.408 off end	# WDTMEM
							device pnp 2e.708 on		# GPIO1
								irq 0xf0 = 0xf7
								irq 0xf1 = 0xf3
							end
							device pnp 2e.9   on		# GPIO2
								irq 0xe0 = 0xdf
								irq 0xe1 = 0xd0
							end
							device pnp 2e.109 on		# GPIO3
								irq 0xe5 = 0x10
							end
							device pnp 2e.209 on		# GPIO4
								irq 0xf1 = 0x32
							end
							device pnp 2e.309 on		# GPIO5
								irq 0xf5 = 0x6d
							end
							device pnp 2e.a   on		# ACPI
								irq 0xe6 = 0x0a
								irq 0xe7 = 0x11
								irq 0xec = 0x80
								irq 0xed = 0x01
								irq 0xee = 0x10
								irq 0xf2 = 0x5d
								irq 0xfc = 0x80
							end
							device pnp 2e.b   on		# HWM, Front Panel LED
								irq 0x30 = 0x01
								io  0x60 = 0x0290
								io  0x62 = 0
								irq 0x70 = 0
								irq 0xe0 = 0xff
								irq 0xe6 = 0x08
								irq 0xf0 = 0x7e
								irq 0xf5 = 0x10
								irq 0xf7 = 0x87
								irq 0xf8 = 0x47
							end
							device pnp 2e.d   off end	# BCLK, WDT2, WDT_MEM
							device pnp 2e.e   off end	# CIR wake-up
							device pnp 2e.f   off end	# GPIO PP/OD
							device pnp 2e.14  off end	# Port 80 UART
							device pnp 2e.16  off end	# DS5
							device pnp 2e.116 off end	# DS3
							device pnp 2e.316 off end	# PCHDSW
							device pnp 2e.416 off end	# DSWWOPT
							device pnp 2e.516 on  end	# DS3OPT
							device pnp 2e.616 off end	# DSDSS
							device pnp 2e.716 off end	# DSPU
						end
					end
				end
				chip drivers/pc80/tpm
					device pnp 0c31.0 on end	# TPM header
				end
			end
			device pci 1f.2 on  end		# SATA Controller (AHCI)
			device pci 1f.3 on  end		# SMBus
			device pci 1f.5 off end		# SATA Controller (Legacy)
			device pci 1f.6 off end		# Thermal
		end
	end
end
