    -- Returns False if the block isn't a valid CEA-861 extension.
    function Has_HDMI_Sink (Raw_Ext : Raw_EDID_Data) return Boolean;
 
+   -- Pick highest-resolution mode within per-port hardware limits from Base
+   -- EDID + CEA-861 DTDs, falling back to exact CTA-861 4K30/1080p60 when needed.
+   procedure Select_Best_Mode
+     (Raw_EDID  : in     Raw_EDID_Data;
+      Raw_Ext   : in     Raw_EDID_Data;
+      Has_Ext   : in     Boolean;
+      HDMI_Sink : in     Boolean;
+      Max_Clock : in     Frequency_Type;
+      Max_H     : in     Width_Type;
+      Max_V     : in     Height_Type;
+      Mode      :    out Mode_Type;
+      Found     :    out Boolean)
+   with
+      Pre => Valid (Raw_EDID);
+
 end HW.GFX.EDID;
