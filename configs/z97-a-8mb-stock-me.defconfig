CONFIG_LOCALVERSION="-z97a-v0.17-with-me"
CONFIG_TIMESTAMPS_ON_CONSOLE=y
CONFIG_NO_STAGE_CACHE=y
CONFIG_VENDOR_ASUS=y
CONFIG_ONBOARD_VGA_IS_PRIMARY=y
CONFIG_CONSOLE_POST=y
CONFIG_BOARD_ASUS_Z97_A=y
CONFIG_IFD_BIN_PATH="blobs/ifd-z97-a-unlocked.bin"
CONFIG_ME_BIN_PATH="blobs/me-z97-a-stock-9.1.25.1005.bin"
CONFIG_GBE_BIN_PATH="blobs/gbe-z97-a.bin"
CONFIG_PCIEXP_DEFAULT_MAX_RESIZABLE_BAR_BITS=35
CONFIG_CONSOLE_CBMEM_BUFFER_SIZE=0x40000
CONFIG_EDK2_BOOT_TIMEOUT=5
CONFIG_INTEL_OC_MAILBOX_ENABLE_UNDERVOLTING=y
CONFIG_HAVE_IFD_BIN=y
CONFIG_EDK2_BOOT_MANAGER_ESCAPE=y
# CONFIG_EDK2_FULL_SCREEN_SETUP is not set
CONFIG_EDK2_BOOTSPLASH_FILE=""
CONFIG_USE_NATIVE_RAMINIT=y
CONFIG_PCIEXP_HOTPLUG=y
CONFIG_HAVE_ME_BIN=y
CONFIG_HAVE_GBE_BIN=y
CONFIG_PCIEXP_SUPPORT_RESIZABLE_BARS=y
CONFIG_PCIEXP_LANE_ERR_STAT_CLEAR=y
CONFIG_TPM1=y
CONFIG_DEFAULT_CONSOLE_LOGLEVEL_6=y
CONFIG_CMOS_POST=y
CONFIG_CMOS_POST_OFFSET=0x70
CONFIG_PAYLOAD_EDK2=y
CONFIG_EDK2_TAG_OR_REV="f248a68be339831b69a880d9c932a6a3cf3c461a"
CONFIG_EDK2_LOAD_OPTION_ROMS=y
CONFIG_EDK2_SERIAL_SUPPORT=y
CONFIG_EDK2_CUSTOM_BUILD_PARAMS="-D BOOTSPLASH_IMAGE=FALSE -D NVME_ENABLE=TRUE"
CONFIG_EDK2_ENABLE_IPXE=y
CONFIG_IPXE_MASTER=y
# CONFIG_IPXE_SERIAL_CONSOLE is not set
