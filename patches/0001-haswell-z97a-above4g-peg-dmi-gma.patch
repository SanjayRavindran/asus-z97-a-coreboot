+#if CONFIG(HAVE_ACPI_TABLES)
+static void set_above_4g_pci(const struct device *dev)
+{
+	uint64_t touud = ((uint64_t)pci_read_config32(dev, TOUUD + 4) << 32) |
+			 pci_read_config32(dev, TOUUD);
+	touud &= ~((1ULL << 20) - 1);
+
+	const uint64_t base = MAX(touud, 4ULL * GiB);
+	const uint64_t limit = 1ULL << cpu_phys_address_size();
+	const uint64_t len = (limit > base) ? (limit - base) : 0;
+
+	acpigen_write_scope("\\");
+	acpigen_write_name_qword("A4GB", base);
+	acpigen_write_name_qword("A4GS", len);
+	acpigen_pop_len();
+
+	printk(BIOS_DEBUG, "PCI space above 4GB MMIO is at 0x%llx, len = 0x%llx\n", base, len);
+}
+
+static void mc_gen_ssdt(const struct device *dev)
+{
+	set_above_4g_pci(dev);
+}
